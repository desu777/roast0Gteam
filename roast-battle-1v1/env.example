# 0G Network Configuration
ZERO_G_NETWORK_URL=https://evmrpc-testnet.0g.ai
ZERO_G_CHAIN_ID=16601
ZERO_G_NETWORK_NAME=0G-Galileo-Testnet
ZERO_G_EXPLORER=https://chainscan-galileo.0g.ai/
ZERO_G_CURRENCY_SYMBOL=0G
ZERO_G_CURRENCY_DECIMALS=18

# Treasury & OpenAI
TREASURY_PRIVATE_KEY=your_treasury_private_key_here
TREASURY_ADDRESS=your_treasury_address_here
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3002
NODE_ENV=development
TEST_ENV=true
DATABASE_PATH=./data/battle.db
LOG_LEVEL=debug
LOG_FILE=./logs/battle-1v1.log

# Battle Configuration
BET_AMOUNT=0.5
COUNTDOWN_DURATION=90
HOUSE_FEE_PERCENT=5

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# === NEW CONFIGURABLE VALUES ===

OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.9
OPENAI_MAX_TOKENS=800
OPENAI_STREAMING=true

# AI Dialog Configuration
AI_MAX_DIALOG_EXCHANGES=6
AI_EXCHANGE_BASE_DELAY=1500
AI_EXCHANGE_CHAR_DELAY=15
AI_EXCHANGE_MAX_DELAY=3000
AI_IMPACT_MIN=1
AI_IMPACT_MAX=10
AI_SCORE_MIN=0
AI_SCORE_MAX=100

# Battle Timing
COUNTDOWN_TIMER_INTERVAL=1000
BATTLE_END_DELAY=10000
BATTLE_HISTORY_DEFAULT_LIMIT=1000000
LEADERBOARD_DEFAULT_LIMIT=10

# Treasury Configuration
TREASURY_PAYOUT_INTERVAL=5000
TREASURY_GAS_LIMIT=21000
TREASURY_PAYOUT_BATCH_SIZE=10
TREASURY_MAX_RETRY_ATTEMPTS=3

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_CONNECTION_TIMEOUT=10000
WS_RECONNECT_MAX_DELAY=30000

# Admin & Security
ADMIN_KEY=your_admin_key_here 